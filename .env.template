# LinkedIn Automator Configuration
# Copy this file to .env and fill in your values

# AI Provider: "ollama" or "gemini"
AI_PROVIDER=ollama

# Ollama settings (used when AI_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Gemini settings (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# LinkedIn automation settings
DAILY_CAP=20
TOTAL_HOURS=10

# Chrome profile auto-detection: leave blank to auto-detect
# Common paths:
#   Chrome:   ~/.config/google-chrome
#   Chromium: ~/.config/chromium
CHROME_PROFILE_PATH=

# Company list fuzzy match threshold (0-100, higher = stricter)
FUZZY_MATCH_THRESHOLD=80
